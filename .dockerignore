# What a git-based `docker build` (the GitHub-triggered Cloud Build) must NOT copy into the image.
# The API needs only: api.py, forecasting.py, district_forecast.py and serving/ (models and small views of the dataset).
# deploy/stage_build.py lists the same files for local checks.
.git
.github
.venv
**/__pycache__
**/*.pyc
.claude
.impeccable
.gitignore
.python-version
frontend
figures
data
pipeline
deploy
extra
*.ipynb
*.docx
*.docm
*.pdf
*.md
app.py
run_app.bat
test_*.py
train_v3.py
features.py
model_metrics.json
crop_yield_model_v3.pkl
master_dataset_*.csv
requirements-data.txt
crop_yield_model_v2_extra_trees.pkl
